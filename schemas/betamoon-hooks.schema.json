{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BetaMoon hook files",
  "description": "Package-relative Lua files defining hook registries. All selectors, options and callbacks belong in Lua.",
  "type": "array",
  "maxItems": 32,
  "uniqueItems": true,
  "items": {
    "type": "string",
    "minLength": 4,
    "maxLength": 512,
    "pattern": "^(?![\\s\\S]*\\.(?:/|$))(?:[^/\\\\:*?\"<>|\\u0000-\\u001f\\u007f-\\u009f]+/)*[^/\\\\:*?\"<>|\\u0000-\\u001f\\u007f-\\u009f]*\\.lua$",
    "examples": [
      "hooks/world.lua",
      "hooks/menus.lua"
    ]
  }
}
